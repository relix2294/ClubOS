# ClubOS M0 — переменные окружения dev-стека (docker compose).
# Скопируйте в .env и задайте СВОИ значения. Файл .env не коммитится (.gitignore).
# Здесь — только имена и безопасные примеры, не реальные секреты (ТЗ §0, §27.3).

# Пароль PostgreSQL (dev).
CLUBOS_DB_PASSWORD=change-me-db-password

# Ключ подписи JWT сотрудников, не короче 32 символов. Сгенерировать: openssl rand -base64 48
CLUBOS_AUTH_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-chars

# Dev Owner для входа в Admin Web (создаётся seed'ом при первом запуске).
CLUBOS_SEED_OWNER_EMAIL=owner@demo.clubos.local
CLUBOS_SEED_OWNER_PASSWORD=change-me-owner-password

# Одноразовый enrollment-токен Edge для dev-bootstrap (>= 24 символа). Сгенерировать: openssl rand -hex 24
# В пилоте токен создаётся в Admin Web → «Подключение». После регистрации Edge токен больше не нужен.
CLUBOS_DEV_EDGE_ENROLLMENT_TOKEN=change-me-random-hex-token-000000000000
