# Пример переменных окружения ClubOS (M0). Скопируйте в .env и подставьте свои значения.
# НИКОГДА не коммитьте реальный .env с секретами (ТЗ §0, §27.3).

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=clubos
POSTGRES_PASSWORD=clubos_dev
POSTGRES_DB=clubos

# --- Cloud API ---
# Строка подключения к PostgreSQL
CLUBOS_DB_CONNECTION=Host=localhost;Port=5432;Database=clubos;Username=clubos;Password=clubos_dev
# Ключ подписи JWT (>= 32 байт). В проде — из секрет-хранилища, не из файла.
CLUBOS_JWT_KEY=change-me-please-use-a-32-plus-byte-secret
# Пароль dev-владельца при первичном seed
CLUBOS_DEV_OWNER_PASSWORD=ChangeMe123!

# --- Edge Controller ---
EDGE_CLOUD_URL=http://localhost:5000/
EDGE_DB_PATH=edge-data/edge.db
# Bearer-токен Edge для sync в Cloud (получить через Cloud auth)
# EDGE_CLOUD_TOKEN=

# --- Windows Agent ---
CLUBOS_CLOUD_URL=http://localhost:5000/
CLUBOS_EDGE_URL=http://localhost:5080/
# Одноразовый enrollment-токен (выдаётся в Cloud)
# CLUBOS_ENROLLMENT_TOKEN=

# --- Device Simulator ---
SIM_EDGE_URL=http://localhost:5080/
SIM_DEVICE_COUNT=5
SIM_HEARTBEAT_SECONDS=10

# --- Admin Web ---
NEXT_PUBLIC_API_URL=http://localhost:5000
