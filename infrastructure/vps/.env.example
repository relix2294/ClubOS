# ClubOS Cloud на VPS. Скопируйте в .env и задайте СВОИ значения. .env не коммитится.

# Домен (A-запись должна указывать на IP VPS) и email для Let's Encrypt.
CLUBOS_DOMAIN=clubos.example.tj
CLUBOS_ACME_EMAIL=admin@example.tj

# Пароль PostgreSQL. Сгенерировать: openssl rand -base64 24
CLUBOS_DB_PASSWORD=change-me

# Ключ подписи JWT персонала (>= 32 символа). Сгенерировать: openssl rand -base64 48
CLUBOS_AUTH_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-chars

# Первый владелец (Owner) для входа в Admin Web. Пароль >= 10 символов.
CLUBOS_OWNER_EMAIL=owner@example.tj
CLUBOS_OWNER_PASSWORD=change-me-strong-password

# Имена, которые seed создаст при ПЕРВОМ запуске (потом не меняются через .env).
CLUBOS_OWNER_NAME=Владелец
CLUBOS_ORGANIZATION_NAME=Demo Club Group
CLUBOS_LOCATION_NAME=Dushanbe Pilot
